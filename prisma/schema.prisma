// Prisma schema. Models are added here module by module.
// Connection URLs live in prisma.config.ts (CLI) and src/prisma/prisma.service.ts (app).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Shared enums
// ─────────────────────────────────────────────────────────────

enum PaymentMode {
  CASH
  UPI
  BANK
  CHEQUE
}

enum Unit {
  KG
  G
  L
  ML
  PCS
  PACK
  BOX
  CARTON
  BAG
  ROLL
  METER
}

// ─────────────────────────────────────────────────────────────
// Module 1 – Workers
// ─────────────────────────────────────────────────────────────

enum PayType {
  DAILY
  MONTHLY
}

enum PayCycle {
  WEEKLY
  MONTHLY
  MANUAL
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
  PAID_LEAVE
}

model Worker {
  id                  Int      @id @default(autoincrement())
  name                String
  phone               String?
  role                String?
  joiningDate         DateTime @db.Date
  payType             PayType
  /// ₹ per day (DAILY) or ₹ per month (MONTHLY)
  rate                Decimal  @db.Decimal(10, 2)
  /// MONTHLY only: day value = rate / workingDaysPerMonth
  workingDaysPerMonth Int?     @default(26)
  payCycle            PayCycle @default(MANUAL)
  /// WEEKLY: 0 = Sunday … 6 = Saturday
  payWeekday          Int?
  /// MONTHLY: 1–31 (clamped to month length)
  payMonthDay         Int?
  notes               String?
  /// Permanent staff are listed first on the attendance screen; the rest are temporary.
  permanent           Boolean  @default(false)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  attendance        Attendance[]
  attendanceChanges AttendanceChange[]
  advances          Advance[]
  settlements       Settlement[]
}

model Attendance {
  id        Int              @id @default(autoincrement())
  workerId  Int
  date      DateTime         @db.Date
  status    AttendanceStatus
  /// Snapshot of the worker's day value when marked
  dayValue  Decimal          @db.Decimal(10, 2)
  bonus     Decimal          @default(0) @db.Decimal(10, 2)
  /// dayValue × (1 | 0.5 | 0) + bonus — stored so totals are a plain SUM
  earned    Decimal          @db.Decimal(10, 2)
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  worker  Worker             @relation(fields: [workerId], references: [id])
  changes AttendanceChange[]

  @@unique([workerId, date])
  @@index([date])
}

/// Edits to days inside an already-settled period (shown in the next settlement).
/// A null status means the day was not marked (before) or was cleared (after).
model AttendanceChange {
  id                     Int               @id @default(autoincrement())
  attendanceId           Int?
  workerId               Int
  date                   DateTime          @db.Date
  oldStatus              AttendanceStatus?
  oldBonus               Decimal           @default(0) @db.Decimal(10, 2)
  newStatus              AttendanceStatus?
  newBonus               Decimal           @default(0) @db.Decimal(10, 2)
  /// newEarned − oldEarned
  difference             Decimal           @db.Decimal(10, 2)
  reportedInSettlementId Int?
  changedAt              DateTime          @default(now())

  attendance           Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  worker               Worker      @relation(fields: [workerId], references: [id])
  reportedInSettlement Settlement? @relation(fields: [reportedInSettlementId], references: [id])

  @@index([workerId, changedAt])
}

model Advance {
  id        Int         @id @default(autoincrement())
  workerId  Int
  date      DateTime    @db.Date
  amount    Decimal     @db.Decimal(10, 2)
  mode      PaymentMode @default(CASH)
  note      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  worker Worker @relation(fields: [workerId], references: [id])

  @@index([workerId, date])
}

model Settlement {
  id             Int         @id @default(autoincrement())
  workerId       Int
  periodStart    DateTime    @db.Date
  periodEnd      DateTime    @db.Date
  // Summary frozen at settlement time (for pay history display)
  daysWorked     Decimal     @db.Decimal(5, 1)
  earned         Decimal     @db.Decimal(12, 2)
  bonus          Decimal     @db.Decimal(12, 2)
  advances       Decimal     @db.Decimal(12, 2)
  broughtForward Decimal     @db.Decimal(12, 2)
  payable        Decimal     @db.Decimal(12, 2)
  amountPaid     Decimal     @db.Decimal(12, 2)
  mode           PaymentMode @default(CASH)
  paidOn         DateTime    @db.Date
  note           String?
  createdAt      DateTime    @default(now())

  worker          Worker             @relation(fields: [workerId], references: [id])
  reportedChanges AttendanceChange[]

  @@index([workerId, periodEnd])
}

// ─────────────────────────────────────────────────────────────
// Module 2 – Stock (materials)
// ─────────────────────────────────────────────────────────────

enum MaterialType {
  RAW
  SUPPLY
}

enum StockMovementType {
  OPENING
  PURCHASE
  USAGE
  ADJUSTMENT
}

model Material {
  id              Int          @id @default(autoincrement())
  name            String       @unique
  type            MaterialType
  unit            Unit
  /// Running total, updated in the same transaction as each movement
  currentQty      Decimal      @default(0) @db.Decimal(12, 3)
  lowStockLevel   Decimal?     @db.Decimal(12, 3)
  lastCostPerUnit Decimal?     @db.Decimal(12, 2)
  notes           String?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  movements      StockMovement[]
  usedInProducts ProductMaterial[]
}

model StockMovement {
  id                Int               @id @default(autoincrement())
  materialId        Int
  date              DateTime          @db.Date
  type              StockMovementType
  /// Signed: + in, − out
  quantity          Decimal           @db.Decimal(12, 3)
  costPerUnit       Decimal?          @db.Decimal(12, 2)
  supplier          String?
  note              String?
  productionEntryId Int?
  /// USAGE only: the product this material was used for (null = general use, e.g. supplies for the day)
  productId         Int?
  /// USAGE for a product: what the recipe says it should have taken (snapshot), for wastage = used − expected
  expectedQty       Decimal?          @db.Decimal(12, 3)
  createdAt         DateTime          @default(now())

  material        Material         @relation(fields: [materialId], references: [id])
  productionEntry ProductionEntry? @relation(fields: [productionEntryId], references: [id], onDelete: Cascade)
  product         Product?         @relation(fields: [productId], references: [id])

  @@index([materialId, date])
  @@index([productId, date])
}

/// Day-end entry: materials used (and, from module 3, products made)
model ProductionEntry {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materialMovements StockMovement[]
  productMovements  ProductStockMovement[]
}

// ─────────────────────────────────────────────────────────────
// Module 3 – Products
// ─────────────────────────────────────────────────────────────

enum ProductMovementType {
  OPENING
  PRODUCED
  SOLD
  SALE_CANCELLED
  ADJUSTMENT
}

model Product {
  id           Int      @id @default(autoincrement())
  /// e.g. "Mahadeva Maida Noodles 1.5mm" — never printed on invoices
  internalName String   @unique
  /// e.g. "Mahadeva Noodles" — used on invoices and anything shared
  publicName   String
  code         String?  @unique
  /// What one unit sold is called: PACK, BAG, BOX, …
  saleUnit     Unit     @default(PACK)
  /// Pieces inside one unit sold (e.g. 10 for "10 × 500 g"); null = single packaging (e.g. a 25 kg bag)
  piecesPerUnit Int?
  /// Size of each piece, or of the whole unit when there are no pieces (e.g. 500 G, 25 KG)
  packSize     Decimal? @db.Decimal(10, 3)
  packUnit     Unit?
  /// Price per unit sold (pack, bag, …). Null = worked out from piecePrice.
  price        Decimal? @db.Decimal(12, 2)
  /// Price per piece, or per kg/L, when sold loose (the stock unit). Null = worked out from price.
  /// At least one of price / piecePrice is set.
  piecePrice   Decimal? @db.Decimal(12, 2)
  mrp          Decimal? @db.Decimal(12, 2)
  hsnCode      String?
  /// Percent, e.g. 5.00; null = no GST
  gstRate      Decimal? @db.Decimal(5, 2)
  /// Internal-only specs: [{ "key": "Thickness", "value": "1.5 mm" }]
  specs        Json?
  /// Finished goods in stock (running total), in the stock unit: pieces if the product has pieces,
  /// KG/L if it has a weight/volume, otherwise the sale unit (see src/products/packaging.ts)
  currentQty   Decimal  @default(0) @db.Decimal(12, 3)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  materials     ProductMaterial[]
  movements     ProductStockMovement[]
  saleLines     SaleLine[]
  materialUsage StockMovement[]
}

/// Recipe / bill of materials: how much of a material one sale unit uses
model ProductMaterial {
  id         Int      @id @default(autoincrement())
  productId  Int
  materialId Int
  /// Blank until known; 6 decimals allow fractions like 1/24 carton
  qtyPerUnit Decimal? @db.Decimal(14, 6)
  /// true: qtyPerUnit is per piece (× pieces per unit sold); false: per unit sold
  perPiece   Boolean  @default(false)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@unique([productId, materialId])
}

model ProductStockMovement {
  id                Int                 @id @default(autoincrement())
  productId         Int
  date              DateTime            @db.Date
  type              ProductMovementType
  /// Signed: + in, − out
  quantity          Decimal             @db.Decimal(12, 3)
  note              String?
  productionEntryId Int?
  saleId            Int?
  createdAt         DateTime            @default(now())

  product         Product          @relation(fields: [productId], references: [id])
  productionEntry ProductionEntry? @relation(fields: [productionEntryId], references: [id], onDelete: Cascade)
  sale            Sale?            @relation(fields: [saleId], references: [id])

  @@index([productId, date])
}

// ─────────────────────────────────────────────────────────────
// Module 4 – Buyers
// ─────────────────────────────────────────────────────────────

model Buyer {
  id             Int      @id @default(autoincrement())
  name           String
  /// Name printed on invoices (registered business name); null = same as name
  invoiceName    String?
  contactPerson  String?
  phone          String?
  altPhone       String?
  email          String?
  address        String?
  city           String?
  /// Indian state name; compared with the company's state for CGST/SGST vs IGST
  state          String?
  pincode        String?
  gstin          String?
  /// null = use CompanyProfile.defaultCreditDays
  creditDays     Int?
  /// Amount owed before the app was used
  openingBalance Decimal  @default(0) @db.Decimal(12, 2)
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales    Sale[]
  payments Payment[]

  @@index([name])
}

model Payment {
  id        Int         @id @default(autoincrement())
  buyerId   Int
  date      DateTime    @db.Date
  amount    Decimal     @db.Decimal(12, 2)
  mode      PaymentMode
  /// UTR, cheque number, etc.
  reference String?
  note      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  buyer       Buyer               @relation(fields: [buyerId], references: [id])
  allocations PaymentAllocation[]

  @@index([buyerId, date])
}

/// How much of a payment settled which sale (unallocated remainder still reduces the buyer balance)
model PaymentAllocation {
  id        Int     @id @default(autoincrement())
  paymentId Int
  saleId    Int
  amount    Decimal @db.Decimal(12, 2)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sale    Sale    @relation(fields: [saleId], references: [id])

  @@unique([paymentId, saleId])
}

// ─────────────────────────────────────────────────────────────
// Module 5 – Sales
// ─────────────────────────────────────────────────────────────

enum InvoiceType {
  TAX_INVOICE
  BILL
}

enum SalePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

/// Single row (id = 1)
model CompanyProfile {
  id                Int      @id @default(1)
  businessName      String
  address           String?
  city              String?
  state             String?
  pincode           String?
  phone             String?
  email             String?
  gstin             String?
  fssaiNumber       String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?
  upiId             String?
  logoUrl           String?
  invoicePrefix     String   @default("MF")
  termsText         String?
  signatoryName     String?
  defaultCreditDays Int      @default(15)
  pricesIncludeGst  Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

/// Gapless invoice numbering per financial year, incremented inside the sale transaction
model InvoiceCounter {
  /// e.g. "2026-27"
  financialYear String @id
  lastNumber    Int    @default(0)
}

model Sale {
  id            Int               @id @default(autoincrement())
  /// e.g. "MF/2026-27/0001"
  invoiceNumber String            @unique
  financialYear String
  sequence      Int
  type          InvoiceType
  date          DateTime          @db.Date
  /// date + credit days; overdue = dueDate < today and not PAID
  dueDate       DateTime          @db.Date
  buyerId       Int
  // Buyer details as printed on the invoice
  buyerName     String
  buyerAddress  String?
  buyerPhone    String?
  buyerGstin    String?
  placeOfSupply String?
  isInterState  Boolean           @default(false)
  // Totals
  subtotal      Decimal           @db.Decimal(12, 2)
  discountTotal Decimal           @default(0) @db.Decimal(12, 2)
  taxableTotal  Decimal           @db.Decimal(12, 2)
  cgstTotal     Decimal           @default(0) @db.Decimal(12, 2)
  sgstTotal     Decimal           @default(0) @db.Decimal(12, 2)
  igstTotal     Decimal           @default(0) @db.Decimal(12, 2)
  roundOff      Decimal           @default(0) @db.Decimal(6, 2)
  grandTotal    Decimal           @db.Decimal(12, 2)
  // Payment tracking (updated with allocations)
  amountPaid    Decimal           @default(0) @db.Decimal(12, 2)
  paymentStatus SalePaymentStatus @default(UNPAID)
  notes         String?
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  buyer          Buyer                  @relation(fields: [buyerId], references: [id])
  lines          SaleLine[]
  allocations    PaymentAllocation[]
  stockMovements ProductStockMovement[]

  @@unique([financialYear, sequence])
  @@index([buyerId, date])
  @@index([paymentStatus, dueDate])
}

model SaleLine {
  id           Int     @id @default(autoincrement())
  saleId       Int
  lineNo       Int
  productId    Int
  // Snapshot at time of sale (public name only)
  publicName   String
  /// Packaging at time of sale, e.g. "10 × 500 g pack (5 kg)"
  description  String?
  hsnCode      String?
  /// In `unit` (pack, piece, bag, kg, …)
  quantity     Decimal @db.Decimal(12, 3)
  unit         Unit
  /// Same quantity in the product's stock unit (what this line took from stock)
  stockQty     Decimal @db.Decimal(12, 3)
  rate         Decimal @db.Decimal(12, 2)
  discount     Decimal @default(0) @db.Decimal(12, 2)
  taxableValue Decimal @db.Decimal(12, 2)
  gstRate      Decimal @default(0) @db.Decimal(5, 2)
  cgst         Decimal @default(0) @db.Decimal(12, 2)
  sgst         Decimal @default(0) @db.Decimal(12, 2)
  igst         Decimal @default(0) @db.Decimal(12, 2)
  lineTotal    Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([saleId, lineNo])
}

// ─────────────────────────────────────────────────────────────
// Expenses & bills
// ─────────────────────────────────────────────────────────────

/// A miscellaneous expense, recorded when it is paid (tea, transport, repairs, …).
model Expense {
  id        Int         @id @default(autoincrement())
  date      DateTime    @db.Date
  amount    Decimal     @db.Decimal(12, 2)
  /// Free text with suggestions from past entries, e.g. "Transport"
  category  String
  note      String?
  mode      PaymentMode @default(CASH)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([date])
}

/// A bill to pay by a due date (electricity, rent, …). Unpaid until marked paid.
model Bill {
  id        Int          @id @default(autoincrement())
  /// Who or what, e.g. "Electricity" or "Shop rent"
  name      String
  amount    Decimal      @db.Decimal(12, 2)
  billDate  DateTime?    @db.Date
  dueDate   DateTime     @db.Date
  paidOn    DateTime?    @db.Date
  mode      PaymentMode?
  /// UTR, cheque number, …
  reference String?
  note      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([dueDate])
}
