# Copy to .env and adjust.

# App connection. Locally: the docker-compose Postgres. In production: Supabase pooled connection string.
DATABASE_URL="postgresql://mfp:mfp@localhost:5432/mfp?schema=public"
# Used by Prisma CLI for migrations. In production: Supabase direct connection string. Optional locally.
# DIRECT_URL=""

PORT=4001
# Comma-separated list of allowed frontend origins (Next.js dev server, Capacitor Android app).
CORS_ORIGINS="http://localhost:3001,https://localhost"
